{
  "name": "msj",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 30000,
    "subrequests": 1000
  },
  "vars": {
    "META_GRAPH_VERSION": "v26.0",
    "OPENAI_MODEL": "gpt-5.6-luna"
  }
}
